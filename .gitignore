# Log files — giữ trên máy local để đối chiếu, không cần versioning
# (CLAUDE.md mục 7.2)
reports/logs/*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg

# Môi trường ảo
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Trọng số mô hình lớn — commit có chọn lọc, không commit tự động
# (bỏ comment dòng dưới nếu muốn ignore toàn bộ)
# models/*.pt

# Dữ liệu raw snapshot có thể rất lớn — chỉ commit khi cần thiết
# data/raw/snapshot_*/
